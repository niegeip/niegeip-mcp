# Local development only; official deployment must use HTTPS and NIEGEIP_LOCAL=false.
NIEGEIP_LOCAL=true
NIEGEIP_ISSUER=http://127.0.0.1:8787
NIEGEIP_API_URL=http://127.0.0.1:8081/api/web
NIEGEIP_HOST=127.0.0.1
PORT=8787
# Generate locally: node scripts/init-local.mjs (never commit the generated key).
NIEGEIP_STATE_KEY=
NIEGEIP_STATE_PATH=.state/oauth.enc
# Comma-separated browser MCP client origins. Native clients without Origin also work.
NIEGEIP_CLIENT_ORIGINS=
# Operator-approved object-storage/CDN hostnames for the local download helper.
NIEGEIP_DOWNLOAD_HOSTS=
