{
  "name": "niegeip-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "NiegeIP purchased IP assets MCP server and Codex plugin",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:package",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test:browser": "tsx test/browser.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/niegeip/niegeip-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/niegeip/niegeip-mcp/issues"
  },
  "homepage": "https://github.com/niegeip/niegeip-mcp#readme"
}
